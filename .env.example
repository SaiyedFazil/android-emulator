# Copy to .env.local and fill in. Never commit .env.local.

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Encrypts the session cookie. Generate one with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# How long the session cookie may live, in days. The session really ends when the backend's
# refresh token does, so keep this at least the backend's REFRESH_TTL_DAYS_PERSISTENT.
AUTH_SESSION_MAX_AGE_DAYS=30

# ─── Backend API ──────────────────────────────────────────────────────────────
# What the browser calls (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
# What the Next server calls for sign-in and refresh. Empty means NEXT_PUBLIC_API_URL; set it when
# the server reaches the API at another address (e.g. http://api:5001/api/v1 inside Docker).
API_URL=

# ─── Opening the dev server from other devices ───────────────────────────────
# This machine's network IP (e.g. 192.168.1.2), so phones and other computers on the network can
# use `npm run dev`. Also point NEXT_PUBLIC_API_URL at that IP and add http://<ip>:5000 to the
# backend's CORS_ORIGINS. Leave empty to use localhost only.
DEV_HOST=
